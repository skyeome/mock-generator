# AI Configuration

AI_ENABLED=true
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
AI_FALLBACK_ON_ERROR=true

# Development: OpenAI-compatible API (LM Studio)
# Used when NODE_ENV=development
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=openai/gpt-oss-20b

# Production: Cloudflare Workers AI
# Used when NODE_ENV=production
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
